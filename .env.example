# Demo credentials only. Never commit the key file.
KALSHI_API_KEY_ID=replace-with-demo-key-id
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/demo-private-key.key

# Production credentials use separate names. Leave blank until supervised live testing.
KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=

# Live limits can only tighten the hard-coded one-contract/$1 safety ceiling.
KALSHI_LIVE_MAX_CONTRACTS=1
KALSHI_LIVE_MAX_ORDER_COST=1
KALSHI_LIVE_MAX_ABS_POSITION=1
KALSHI_LIVE_MIN_EDGE=0.02
KALSHI_LIVE_MAX_SPREAD=0.15
KALSHI_LIVE_MAX_QUEUE_AHEAD=500
KALSHI_LIVE_MAX_TRADE_AGE_SECONDS=900
KALSHI_LIVE_MIN_RECENT_CONTRACTS=1
KALSHI_LIVE_MAX_EXPIRATION_SECONDS=300

# Do not persist KALSHI_LIVE_TRADING_ENABLED in this file. Export it only for
# the supervised command, then unset it immediately.

# The Odds API credential. Keep the real value in .env only.
ODDS_API_KEY=replace-with-odds-api-key
